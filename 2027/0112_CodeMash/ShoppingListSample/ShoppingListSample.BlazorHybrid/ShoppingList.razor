@using ShoppingListSample.Shared

<main class="shopping-list">
    <form class="shopping-toolbar" @onsubmit="AddItem" @onsubmit:preventDefault>
        <div class="shopping-field shopping-category">
            <label for="category">Category:</label>
            <select id="category" @bind="newItem.Category.Name">
                <option value="">Select category</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Name">@category.Name</option>
                }
            </select>
        </div>
        <div class="shopping-field shopping-name">
            <label for="name">Name:</label>
            <input type="text" id="name" @bind="newItem.Name" @bind:event="oninput" />
        </div>
        <button type="submit" class="shopping-button">Add Item</button>
    </form>

    <div class="shopping-grid" role="region" aria-label="Shopping list" tabindex="0">
        <table class="shopping-table">
            <thead>
                <tr>
                    <th scope="col">Category</th>
                    <th scope="col">Name</th>
                    <th scope="col" class="purchased-column">Purchased</th>
                    <th scope="col" class="actions-column"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr @key="item">
                        <td>@(item.Category?.Name)</td>
                        <td>@item.Name</td>
                        <td class="purchased-column">
                            <input type="checkbox" @bind="item.IsComplete" aria-label="@($"Purchased: {item.Name}")" />
                        </td>
                        <td class="actions-column">
                            <button type="button" class="shopping-button" @onclick="() => items.Remove(item)" aria-label="@($"Delete {item.Name}")">Delete</button>
                        </td>
                    </tr>
                }
                @if (items.Count == 0)
                {
                    <tr><td colspan="4" class="empty-list">No items yet. Add an item above.</td></tr>
                }
            </tbody>
        </table>
    </div>
</main>

@code {
    internal IList<Item> items;
    internal IList<Category> categories;
    internal Item newItem;

    public ShoppingList()
    {
        newItem = new Item();
        newItem.Category = new Category();
        categories = ShoppingListHelpers.CreateCategories();
        items = new List<Item>(ShoppingListHelpers.CreateDemoShoppingListItems());
    }

    private void AddItem()
    {
        var selectedCategory = categories.FirstOrDefault(c => c.Name == newItem.Category.Name);
        if (string.IsNullOrWhiteSpace(newItem.Name) || selectedCategory is null)
        {
            return;
        }
        newItem.IsComplete = false;
        newItem.Category = selectedCategory;
        items.Add(newItem);
        newItem = new Item();
        newItem.Category = new Category();
    }
}