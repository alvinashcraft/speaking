{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch hosted-toolbox-client",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build hosted-toolbox-client",
      "program": "${workspaceFolder}/bin/Debug/net10.0/hosted-toolbox-client.dll",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}